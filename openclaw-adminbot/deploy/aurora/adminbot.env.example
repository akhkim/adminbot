# Copy to ~/.config/jinesis-adminbot/adminbot.env on Aurora and chmod 600.
# Do not commit the populated file.

# Required Gateway authentication. Generate a long random value, for example:
#   openssl rand -hex 32
OPENCLAW_GATEWAY_TOKEN=REPLACE_ME_WITH_A_RANDOM_GATEWAY_TOKEN

# Required gog account and non-interactive keyring access. Keep GOG_ACCOUNT and ADMINBOT_BOT_EMAIL
# the same address: one is what gog authenticates as, the other is what AdminBot's own code sends,
# schedules and filters as.
GOG_ACCOUNT=REPLACE_ME_WITH_THE_BOT_GOOGLE_ACCOUNT
GOG_KEYRING_PASSWORD=REPLACE_ME_WITH_THE_KEYRING_PASSWORD
GOG_BIN=__HOME__/.local/bin/gog

# Required for calendar ACL ("See all events") changes.
GWS_BIN=__HOME__/.local/bin/gws

# Private extraction remains on the loopback Qwen3.5 122B A10B NVFP4 vLLM endpoint.
ADMINBOT_LOCAL_BASE_URL=http://127.0.0.1:8000/v1
ADMINBOT_LOCAL_MODEL=nvidia/Qwen3.5-122B-A10B-NVFP4
VLLM_API_KEY=vllm-local
JINESIS_VLLM_MODEL_HOME=REPLACE_ME_WITH_THE_VLLM_MODEL_HOME_PATH

# PaperFlow LinkedIn drafting. The draft connector reads the compiled paper PDF and writes the
# announcement post through OpenRouter; the abstract and the author names leave Aurora on this
# path, which is deliberate for copy about a paper that is about to be public. Leave unset and
# "Draft the LinkedIn post" fails with a message naming this file -- it never falls back to a
# templated post. A workspace .env cannot supply this key: it is blocked there on purpose.
# OPENROUTER_API_KEY=sk-or-v1-...
# OPENROUTER_MODEL=openai/gpt-5

# Required for the reviewing-cycle timer: the oneshot posts to the AdminBot API on
# loopback and authenticates with this token, the same one the Control UI uses.
ADMINBOT_SERVICE_TOKEN=REPLACE_ME_WITH_THE_ADMINBOT_SERVICE_TOKEN

# Optional inbound member-profile synchronization. The tab must contain an "AdminBot ID" column;
# only the safe profile columns documented in docs/deploy/aurora-adminbot.md are imported. Leave
# either value empty to keep the systemd poller disabled.
#
# The Membership tab's roster grid does NOT need these: it defaults to the lab's own spreadsheet
# and to gid 764749323 on it, which is the "Full Slack Member List" tab. Set them to point both the
# poller and the grid somewhere else -- ADMINBOT_MEMBER_SHEET_TAB overrides the tab for the grid
# alone.
# ADMINBOT_MEMBER_SHEET_ID=
# ADMINBOT_MEMBER_SHEET_RANGE=Members!A:Z
# ADMINBOT_MEMBER_SHEET_TAB=Full Slack Member List
#
# Prefer naming the tab by gid rather than by title: a gid survives a rename, and the grid resolves
# it to the tab's current title on every read. ADMINBOT_MEMBER_SHEET_URL takes the whole URL out of
# the browser's address bar and carries both the spreadsheet id and the gid; ADMINBOT_MEMBER_SHEET_GID
# names one against ADMINBOT_MEMBER_SHEET_ID. Either beats ADMINBOT_MEMBER_SHEET_TAB.
# ADMINBOT_MEMBER_SHEET_URL=https://docs.google.com/spreadsheets/d/1ZqdaRzev6fFHxGbaAn_NDAPgv-Wi-hklHrT5jB68m68/edit?gid=764749323#gid=764749323
# ADMINBOT_MEMBER_SHEET_GID=764749323

# Workshop-match sweeps (Nudges -> Workshop matches) run against the loopback vLLM two calls at
# a time, matching its --max-num-seqs 2; more than that only queues inside vLLM and times out.
# Raise this only if the model server is started with more sequence slots.
# ADMINBOT_WORKSHOP_MATCH_CONCURRENCY=2

# OpenReview reviewing-cycle automation. Without these the bridge reports
# no_credentials and the 6-hourly pass is a no-op, so the timer stays disabled.
# ADMINBOT_OPENREVIEW_SEND is the delivery kill switch: reminders are composed,
# recorded, and visible in the console but never posted until it is set to 1.
# OPENREVIEW_USERNAME=
# OPENREVIEW_PASSWORD=
# ADMINBOT_OPENREVIEW_SEND=0

# -----------------------------------------------------------------------------
# Workspace identity — who this deployment is. None of these has a default: the
# repo names no mailbox, calendar, channel or invite link of its own, so each
# feature below stays off until its value is set here. See .env.example for the
# per-variable consequence of leaving one unset.
# -----------------------------------------------------------------------------
# The bot's own Google account. Must match GOG_ACCOUNT above.
ADMINBOT_BOT_EMAIL=REPLACE_ME_WITH_THE_BOT_GOOGLE_ACCOUNT
# The shared lab calendar/mailbox members are granted read access on.
ADMINBOT_LAB_EMAIL=REPLACE_ME_WITH_THE_LAB_GOOGLE_ACCOUNT
# Private group calendar behind the "personal" named calendar destination.
ADMINBOT_CALENDAR_ID=REPLACE_ME_WITH_THE_GROUP_CALENDAR_ID
# Slack Connect channel new externals are invited into, and the workspace join link
# the onboarding emails hand out. Without both, onboarding sends refuse to run.
ADMINBOT_ONBOARDING_CHANNEL_ID=REPLACE_ME_WITH_THE_SLACK_CHANNEL_ID
ADMINBOT_SLACK_INVITE_URL=REPLACE_ME_WITH_THE_SLACK_WORKSPACE_INVITE_URL
# The lab's two standing channels. Subgroups the access matrix puts in them -- own-pace advisees
# and coauthor-major -- are invited on their onboarding send. Left unset, those sends still go out
# and report `active_channel_invites: { configured: false }`, so nobody is quietly left uninvited.
#
# An id or a #name both work; an id is safer, since it survives the channel being renamed. The
# combined ADMINBOT_ACTIVE_CHANNEL_IDS="<id>,<id>" is read first if a deployment prefers one line.
JINESIS_ACTIVE_ID=REPLACE_ME_WITH_THE_JINESIS_ACTIVE_CHANNEL_ID
RANDOM_ACTIVE_ID=REPLACE_ME_WITH_THE_RANDOM_ACTIVE_CHANNEL_ID
# Comma-separated addresses the onboarding copy tells people to write to, and the
# recipient of reimbursement/error reports.
ADMINBOT_CONTACT_EMAILS=REPLACE_ME_WITH_CONTACT_ADDRESSES
# Comma-separated senders allowed to trigger onboarding by email. Unset, nobody is.
ADMINBOT_ONBOARDING_SENDERS=REPLACE_ME_WITH_PRIVILEGED_SENDER_ADDRESSES
# Where the hallucinated-reference report is cc'd.
ADMINBOT_REPORT_EMAIL=REPLACE_ME_WITH_THE_REPORT_ADDRESS
# Optional social links in the onboarding copy and checklist; unset, those lines
# are simply left out.
# ADMINBOT_PI_LINKEDIN_URL=
# ADMINBOT_LAB_X_URL=

# Control UI origin. Password-reset links must land here: only the Control UI can redeem a reset
# token, so pointing this at the AdminBot service origin lands members on the built-in console,
# which has no confirm step. Unset, the built-in default (the Vercel deploy) is used.
# ADMINBOT_CONTROL_UI_URL=https://jinesis-admin.vercel.app

# Optional provider/API credentials used by configured AdminBot features.
# NVIDIA_API_KEY=
# SLACK_BOT_TOKEN=
# SLACK_APP_TOKEN=
# SLACK_USER_TOKEN=
