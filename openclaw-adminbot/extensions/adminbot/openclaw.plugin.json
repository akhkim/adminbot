  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "serviceBaseUrl": {
        "type": "string",
        "description": "Loopback AdminBot service URL. Defaults to http://127.0.0.1:8765."
      },
      "serviceTokenEnv": {
        "type": "string",
        "description": "Environment variable containing the AdminBot service bearer token."
      },
      "allowInsecureRemoteService": {
        "type": "boolean",
        "description": "Allow non-loopback AdminBot service URLs. Keep false unless a separate network policy protects the service."
      },
      "defaultDryRun": {
        "type": "boolean",
        "description": "Ask the AdminBot service to simulate proposals and executions by default."
      }
    }
  },
  "uiHints": {
    "serviceBaseUrl": {
      "label": "Service URL",
      "placeholder": "http://127.0.0.1:8765",
      "help": "Loopback AdminBot service endpoint."
    },
    "serviceTokenEnv": {
      "label": "Service token environment variable",
      "placeholder": "ADMINBOT_SERVICE_TOKEN",
      "help": "Environment variable containing the bearer token for the local AdminBot service."
    },
    "defaultDryRun": {
      "label": "Default dry-run mode",
      "help": "Keep proposals and executions simulated unless an explicit action overrides dry-run."
    },
    "allowInsecureRemoteService": {
      "label": "Allow remote service URL",
      "help": "Advanced: allow non-loopback AdminBot service URLs only when a separate network policy protects the service.",
      "advanced": true
    }
  }
