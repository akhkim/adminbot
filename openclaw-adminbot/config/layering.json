  "rules": {
    "applicationLayer": {
      "domains": [
        "agents"
      ],
      "note": "Documented for readers; the checker applies no constraint to these domains."
    },
    "portSurface": {
      "domains": [
        "plugin-sdk"
      ],
      "forbiddenTargets": [
        "gateway",
        "cli",
        "commands"
      ],
      "grandfathered": [
        "plugin-sdk->cli",
        "plugin-sdk->commands",
        "plugin-sdk->gateway"
      ],
      "note": "Hard rule — evaluated independently of frozenEdges. Grandfathered as of 2026-08-08: 27 cli, 5 commands and 29 gateway imports. Drop each entry once its imports are gone."
    },
    "leaf": {
      "domains": [
        "shared"
      ],
      "allowedTargets": [
        "shared",
        "utils",
        "(root)"
      ],
      "mode": "warn",
      "note": "Aspirational: replaced with \"fail\" once src/shared stops reaching into other domains."
    }
  }
