# AdminBot environment
#
# Copy to `.env` (repo-local run) or `~/.openclaw/.env` (systemd/launchd daemon), then fill in
# only what you need. `start-adminbot.mjs` loads `~/.openclaw/.env` itself; the repo-local `.env`
# is read by the OpenClaw CLI and by the `scripts/adminbot-*` jobs.
#
# **Nothing in this file is required to boot.** `node start-adminbot.mjs` with an empty `.env`
# starts, serves `/adminbot` and `/deadlines`, and answers 401 on every privileged route. Every
# variable below buys one feature; without it that feature is disabled or fails at use time, never
# at startup. See the "Run locally" section of README.md.
#
# Env-source precedence (highest -> lowest): process env, ./.env, ~/.openclaw/.env, then the
# `env` block of openclaw.json. A non-empty process env var is never overridden by a dotenv file.
# Direct config keys in openclaw.json (e.g. `gateway.auth.token`) are resolved separately and
# usually win over the env fallback.
#
# Never commit the populated file. `.env`, `client_secret*.json` and `state/` are gitignored.

# -----------------------------------------------------------------------------
# Service — the loopback AdminBot HTTP service itself
# -----------------------------------------------------------------------------
# Listen port for the service. Default 8765, which is what the systemd unit, the hosted Control UI
# and every doc assume. Override it to run a second instance (a fresh clone, a smoke test) beside
# a live one. An unparseable value is a hard startup error, not a fallback to the default.
# ADMINBOT_PORT=8765

# Shared bearer token for machine callers: the OpenReview timer, the reference-check job and
# `adminbot:roster-sync` all POST to the service with it. Unset, those jobs refuse to run
# ("ADMINBOT_SERVICE_TOKEN is not set"); the service still starts and browser/member sessions are
# unaffected, since they authenticate with a login session, not this token. Generate with
# `openssl rand -hex 32`.
# ADMINBOT_SERVICE_TOKEN=

# Comma-separated browser origins allowed to call the service cross-origin. Unset, a built-in
# loopback default list applies, which is enough for local use; set it when a hosted UI on another
# origin must reach this service.
# ADMINBOT_ALLOWED_ORIGINS=https://your-ui.example.com

# Gateway websocket URL handed to a signed-in member's browser. Deliberately has no default: a
# loopback guess would replace a remote member's working gateway URL with a dead one. Unset, the
# client keeps whatever URL it already connects with.
# ADMINBOT_GATEWAY_WS_URL=wss://gateway.example.com

# Base URL used in the "account approved" email. Unset, a built-in default is used, so approval
# emails still send but may point at the wrong host.
# ADMINBOT_DASHBOARD_URL=https://your-ui.example.com

# SQLite ledger path for the `scripts/adminbot-*` batch jobs. The service itself always uses
# `<repo>/state/adminbot.sqlite` and creates it (and `state/`) empty on first boot, so this only
# matters when pointing a script at a different database.
# ADMINBOT_DB_PATH=./state/adminbot.sqlite

# -----------------------------------------------------------------------------
# OpenClaw gateway + paths (inherited core; only needed for the agent/Control UI)
# -----------------------------------------------------------------------------
# Gateway auth. Required only once the gateway binds beyond loopback. Left blank, OpenClaw
# auto-generates a token on first start. Without a shared gateway secret, `/auth/device-token`
# answers 503 and a member's browser cannot be issued a gateway device token — the AdminBot
# service and its HTTP routes are unaffected. Generate with `openssl rand -hex 32`; never paste a
# value copied verbatim from docs, the gateway refuses documented placeholders.
OPENCLAW_GATEWAY_TOKEN=

# Alternative gateway auth mode — use the token OR the password, not both.
# OPENCLAW_GATEWAY_PASSWORD=

# Path overrides (defaults shown). Point these into a scratch directory to run a test instance
# without touching a live `~/.openclaw`.
# OPENCLAW_STATE_DIR=~/.openclaw
# OPENCLAW_CONFIG_PATH=~/.openclaw/openclaw.json
# OPENCLAW_HOME=~

# Extra directories that `$include` directives in openclaw.json may resolve from. Path-list
# separated (':' POSIX, ';' Windows). Without it `$include` is confined to openclaw.json's own
# directory, so a split config fails to load.
# OPENCLAW_INCLUDE_ROOTS=/etc/openclaw/shared:~/.openclaw/shared

# Import missing keys from your login shell profile. Off by default.
# OPENCLAW_LOAD_SHELL_ENV=1
# OPENCLAW_SHELL_ENV_TIMEOUT_MS=15000

# -----------------------------------------------------------------------------
# Models — the agent needs at least one of these to answer anything
# -----------------------------------------------------------------------------
# NVIDIA NIM. This is the remote leg of the privacy broker: a task classified as generic goes here.
# Unset, the broker keeps every task on the local model (see the tunnel section) and logs
# "NVIDIA NIM configured: no" at startup. With neither this nor a local endpoint, agent replies
# fail; the service's own HTTP routes still work.
# NVIDIA_API_KEY=nvapi-...

# OpenRouter, the bundled fallback provider. Unset, that provider is simply unavailable.
# OPENROUTER_API_KEY=sk-or-v1-...

# Other core-generic provider keys still resolve through openclaw.json's models config
# (OPENAI_API_KEY, ANTHROPIC_API_KEY, GEMINI_API_KEY, MINIMAX_API_KEY, TOGETHER_API_KEY, ...).
# None are bundled as plugins in this fork; set one only if you configure that provider yourself.
# OPENAI_API_KEY=sk-...

# Brave Search, used by the agent's web-search tool. Unset, web search is unavailable.
# BRAVE_API_KEY=

# -----------------------------------------------------------------------------
# Local model tunnel — the private leg of the privacy broker
# -----------------------------------------------------------------------------
# Anything the broker classifies as private is answered by this endpoint and never leaves it, and
# reimbursement receipt extraction uses it directly. Unset, the defaults below apply
# (127.0.0.1:8000); if nothing is listening there, private tasks and receipt extraction fail while
# the rest of the service keeps working.
# ADMINBOT_LOCAL_BASE_URL=http://127.0.0.1:8000/v1
# ADMINBOT_LOCAL_MODEL=nvidia/Qwen3.5-122B-A10B-NVFP4
# VLLM_API_KEY=vllm-local

# `pnpm adminbot:tunnel` forwards the local port above to a remote vLLM host when this box has no
# GPU. ADMINBOT_TUNNEL_TARGET is the tailnet address of that host and has no default: unset, the
# tunnel refuses to start rather than relay private traffic to whatever answers a stale address.
# ADMINBOT_TUNNEL_TARGET_HOST is the old name and is still accepted.
# ADMINBOT_TUNNEL_TARGET=100.64.0.1
# ADMINBOT_TUNNEL_TARGET_PORT=8000
# ADMINBOT_TUNNEL_LISTEN_HOST=127.0.0.1
# ADMINBOT_TUNNEL_LISTEN_PORT=8000

# Where the vLLM server keeps model weights and its venv. Only read by the vLLM host bootstrap
# under deploy/aurora/; irrelevant to a local run.
# JINESIS_VLLM_MODEL_HOME=/path/to/vllm-model-home

# -----------------------------------------------------------------------------
# Slack
# -----------------------------------------------------------------------------
# Bot token — every Slack message the message executor sends, and the Slack Connect invite minted
# during onboarding. Unset, Slack-typed actions fail at execution ("Slack bot token is not
# configured") and the member map falls back to roster locations instead of Slack profiles.
# SLACK_BOT_TOKEN=xoxb-...

# App-level token for Socket Mode. Unset, the bot cannot receive events, only send.
# SLACK_APP_TOKEN=xapp-...

# User token, for the few API calls that must act as a person rather than the bot. Unset, those
# calls fail; bot-scoped sends are unaffected.
# SLACK_USER_TOKEN=xoxp-...

# Note: there is no SLACK_SIGNING_SECRET env fallback. The signing secret is only used in the
# plugin's `http` (webhook) mode and is read from `channels.slack.signingSecret` in openclaw.json.
# Socket Mode — what this deployment uses — does not need it at all.

# -----------------------------------------------------------------------------
# Google — Gmail and Calendar, through the external `gog` / `gws` CLIs
# -----------------------------------------------------------------------------
# These are not libraries: `gog` and `gws` are separately installed CLIs holding their own OAuth
# credentials, granted from a Google Cloud `client_secret*.json` you supply out of band.
#
# The Google account the bot sends and schedules as. Unset, gog-typed actions (outbound email,
# calendar writes, Drive workspace provisioning) fail at execution; everything else works.
# GOG_ACCOUNT=your-bot-account@gmail.com

# Passphrase that unlocks gog's keyring non-interactively. Unset, a headless run cannot decrypt
# the stored OAuth token and every Gmail/Calendar action fails.
# GOG_KEYRING_PASSWORD=

# Paths to the CLIs. Unset, they are looked up at ~/.local/bin/gog and ~/.npm-global/bin/gws.
# GOG_BIN=~/.local/bin/gog
# GWS_BIN=~/.npm-global/bin/gws

# Python interpreter for the `scripts/adminbot-*.py` jobs (deadlines, OpenReview, reimbursement
# form fill). Unset, `python3` from PATH is used.
# ADMINBOT_PYTHON=python3

# -----------------------------------------------------------------------------
# Optional integrations — each one enables exactly one executor or job
# -----------------------------------------------------------------------------
# Overleaf. Unset, overleaf-typed actions fail at execution.
# OVERLEAF_API_BASE_URL=
# OVERLEAF_ACCESS_TOKEN=

# Social posting. Unset, the matching social action fails at execution; the other network is
# unaffected.
# LINKEDIN_ACCESS_TOKEN=
# LINKEDIN_AUTHOR_URN=urn:li:person:...
# LINKEDIN_VERSION=202506
# X_ACCESS_TOKEN=

# OpenReview reviewing-cycle reminders. Unset, the bridge reports `no_credentials` and the
# 6-hourly pass is a no-op. ADMINBOT_OPENREVIEW_SEND is the delivery kill switch: without it set
# to 1, every reminder is composed, validated and recorded but never posted.
# OPENREVIEW_USERNAME=
# OPENREVIEW_PASSWORD=
# OPENREVIEW_BASEURL=
# ADMINBOT_OPENREVIEW_SEND=0

# Hallucinated-reference check. Without the Semantic Scholar key the job still runs but demotes
# every verdict that would accuse an author, so only DOI-level contradictions are reported.
# SEMANTIC_SCHOLAR_API_KEY=
# ADMINBOT_REFERENCE_CHECK_VENUES=EMNLP/2026/Conference,aclweb.org/ACL/ARR/2026/August
# ADMINBOT_REFERENCE_MAX_ENTRIES=

# Deadline tracker jobs. Unset, the calendar/digest passes have no calendar or channel to write
# to and do nothing.
# ADMINBOT_DEADLINE_CALENDAR_ID=
# ADMINBOT_ACTIVE_CHANNEL=
# ADMINBOT_ONGOING_SHEET_ID=
# ADMINBOT_READY_SHEET_ID=
# ADMINBOT_HEAD_PROFESSOR_SLACK=

# Reimbursement form templates. Unset, the bundled forms under
# extensions/adminbot/skills/adminbot-reimbursements/forms/ are used.
# ADMINBOT_REIMBURSEMENT_FORMS_DIR=

# Base URL the Python jobs use to reach the service. Unset, http://127.0.0.1:8765 — set it to
# match ADMINBOT_PORT if you moved the service off the default port.
# ADMINBOT_SERVICE_BASE_URL=http://127.0.0.1:8765

# Which openclaw CLI the jobs shell out to. Defaults to the repo-local wrapper.
# OPENCLAW_CLI=./openclaw.mjs

# -----------------------------------------------------------------------------
# Workspace identity — which lab, mailbox, calendar and Slack this deployment is
# -----------------------------------------------------------------------------
# None of these has a default. The repo names no real mailbox, calendar, channel, invite link or
# person of its own, so each feature below is off until the value is set here. Nothing in this
# group is needed to boot: the service starts and serves its public routes without any of them.
#
# The Google account AdminBot sends, schedules and reads Drive as. Unset: the calendar "jinesis"
# destination and the availability-doc import are unavailable, the hourly email automation and the
# Drive downloader exit with a clear error, and the console's planning-doc callout says to set this
# instead of naming an account. Keep it equal to GOG_ACCOUNT, which is what gog itself
# authenticates as. (No onboarding template cites it any more; the "member" email dropped its
# Slack-access step when the portal took that over.)
# ADMINBOT_BOT_EMAIL=your-bot-account@gmail.com

# The shared lab Google account whose calendar members get read access on. Unset: approving a
# member skips the calendar invite (non-fatal, audited), the lab-calendar link is left out of the
# onboarding checklist, and the deadline-calendar job exits with a clear error.
# ADMINBOT_LAB_EMAIL=your-lab-account@gmail.com

# The private group calendar behind the "personal" named calendar destination. Unset: a proposal
# naming that destination is still made, with no calendar_id and a log line naming this variable.
# ADMINBOT_CALENDAR_ID=abc123@group.calendar.google.com

# The Slack Connect channel externals are invited into during onboarding. Unset: minting an invite
# fails with 503 naming this variable, unless the request carries its own slack_channel_id.
# ADMINBOT_ONBOARDING_CHANNEL_ID=C0123456789

# The workspace join link the onboarding copy hands out — Slack Connect invites bounce for people
# with no Slack account at all. Unset: every onboarding template that cites it refuses to send
# (503 naming this variable) rather than mailing a placeholder link.
# ADMINBOT_SLACK_INVITE_URL=https://join.slack.com/t/your-workspace/shared_invite/zt-xxxx

# Comma-separated addresses the onboarding copy tells people to write to, and the recipient of the
# email automation's reimbursement/error reports. Unset: templates citing them refuse to send, and
# the automation's report paths exit with a clear error.
# ADMINBOT_CONTACT_EMAILS=ops@example.edu,admin@example.com

# The example @cs.toronto.edu address the "member" onboarding email uses to illustrate the
# "first initial + last name" format. Illustrative only, so unlike everything else in this group it
# has a fallback: unset, the copy ships the generic jdoe@cs.toronto.edu and still reads correctly.
# ADMINBOT_EMAIL_FORMAT_EXAMPLE=jdoe@cs.toronto.edu

# Comma-separated senders allowed to trigger onboarding by email. Unset: nobody is privileged —
# the automation classifies every sender as untrusted rather than failing open.
# ADMINBOT_ONBOARDING_SENDERS=pi@example.edu,pi.admin@example.edu

# Where the hallucinated-reference report is cc'd. Unset: the job exits with a clear error rather
# than cc a stranger. ADMINBOT_ZHIJING_EMAIL is the old name and is still accepted.
# ADMINBOT_REPORT_EMAIL=pi@example.edu

# Social links in the onboarding copy and the member checklist. Unset: the line or checklist link
# carrying them is simply left out — the email still sends.
# ADMINBOT_PI_LINKEDIN_URL=https://linkedin.com/in/your-pi/
# ADMINBOT_LAB_X_URL=https://x.com/YourLab

# -----------------------------------------------------------------------------
# Deploy targets — hosts this repo pushes to, named nowhere in the tracked tree
# -----------------------------------------------------------------------------
# The Aurora deploy host. Required by scripts/aurora-*.sh; unset, they exit naming this variable.
# AURORA_HOST=your-host.example.internal

# The tailnet the hosted Control UI declares as its default gateway, consumed by
# scripts/vercel-postbuild-index.mjs. ADMINBOT_TAILNET_NODES is a comma list: the first entry is
# the live gateway node, the rest are retired hosts scrubbed out of stale bookmarks. Unset, the
# built page ships without a declared gateway (logged) and the visitor supplies one.
# ADMINBOT_TAILNET_DOMAIN=tailxxxxxx.ts.net
# ADMINBOT_TAILNET_NODES=gateway-node,old-node-1,old-node-2
