# SQLite-first v0alpha service. Keep the real database and secret in ignored local state.
ADMINBOT_DATABASE_URL=file:./state/adminbot-v2.sqlite
ADMINBOT_ORGANIZATION_ID=
ADMINBOT_IDENTITY_KEY_SECRET=
ADMINBOT_API_PORT=8765
# Set true only when the browser reaches the API over HTTPS.
ADMINBOT_SECURE_COOKIES=false

# Comma-separated exact browser origins. The API rejects any browser Origin not listed here.
ADMINBOT_WEB_ORIGINS=http://127.0.0.1:5173

# Use only when the static UI is deployed on a different origin from the API.
VITE_ADMINBOT_API_ORIGIN=http://127.0.0.1:8765
